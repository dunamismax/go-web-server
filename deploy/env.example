# Production environment for the systemd unit. Install as /etc/gowebserver/env
# with mode 0640 and owner root:gowebserver. It holds the database password.

APP_ENV=production

# Listen on loopback only; Caddy is the public face.
HTTP_ADDR=127.0.0.1:8080

DATABASE_URL=postgres://gowebserver:CHANGE-ME@localhost:5432/gowebserver?sslmode=disable

# Caddy runs on the same host, so its X-Forwarded-For header can be trusted.
TRUSTED_PROXIES=127.0.0.1

# To have deploys run migrations with a separate, more privileged role, set
# this to false and run "gowebserver migrate up" with that role's
# DATABASE_URL before restarting the service.
DATABASE_AUTO_MIGRATE=true
