# Build output and downloaded tools (the pinned Tailwind CLI lives in bin/)
/bin/
/tmp/

# Local configuration and secrets
.env
.env.*
!.env.example

# Scratch files written by "templ generate --watch"
*_templ.txt

# Test and profiling output
*.test
*.out
*.prof
coverage.*

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.swp

# Things that tend to get left behind while poking at a running server
cookies.txt
cookies.jar
*.log
