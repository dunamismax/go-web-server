# Copy to .env for local development. The server reads .env on startup;
# variables already set in the environment take precedence over this file.
# In production, set real environment variables instead.

# "development" or "production". Production switches logs to JSON, marks the
# session cookie Secure, and sends an HSTS header.
APP_ENV=development

# Listen address. Platforms that set PORT are honored when this is unset.
HTTP_ADDR=:8080

# PostgreSQL connection string. This matches "make db-up".
DATABASE_URL=postgres://gowebserver:gowebserver@localhost:5432/gowebserver?sslmode=disable
DATABASE_MAX_CONNS=10

# Apply pending migrations at startup. Set to false when deploys run
# "server migrate up" with a separate, more privileged database role.
DATABASE_AUTO_MIGRATE=true

# debug, info, warn or error.
LOG_LEVEL=debug
# text or json. Defaults to text in development and json in production.
#LOG_FORMAT=text

# How long a sign-in lasts.
SESSION_LIFETIME=168h
# Defaults to false in development and true in production.
#SESSION_COOKIE_SECURE=false

# Comma-separated IPs or CIDR ranges of reverse proxies whose X-Forwarded-For
# header should be trusted, e.g. 127.0.0.1 when Caddy runs on the same host.
# Leave empty when clients connect directly.
TRUSTED_PROXIES=

# Extra origins allowed to send state-changing requests, e.g.
# https://admin.example.com. The app's own origin is always allowed.
TRUSTED_ORIGINS=

SHUTDOWN_TIMEOUT=15s
